# =============================================================
# Ingoboka API — Production Environment Template
# =============================================================
# Copy this file to deploy/.env on your EC2 server:
#   cp deploy/.env.example deploy/.env
#   nano deploy/.env   # fill in every value marked REQUIRED
#
# NEVER commit deploy/.env to Git.
# This file (.env.example) is safe to commit — it contains no secrets.
# =============================================================

# ── Container Image (Amazon ECR) ─────────────────────────────
# ECR_REGISTRY format: <account-id>.dkr.ecr.<region>.amazonaws.com
# Example: 123456789012.dkr.ecr.us-east-1.amazonaws.com
ECR_REGISTRY=                       # REQUIRED
ECR_REPOSITORY=ingoboka-api         # REQUIRED — must match the ECR repo name you create
IMAGE_TAG=latest                    # or a specific commit SHA tag

# ── Database (Amazon RDS PostgreSQL) ─────────────────────────
# RDS endpoint format: <identifier>.<id>.<region>.rds.amazonaws.com
# Find it in: AWS Console → RDS → Databases → your instance → Endpoint
RDS_ENDPOINT=                       # REQUIRED — e.g. ingoboka.abc123.us-east-1.rds.amazonaws.com
DB_NAME=ingoboka
DB_USERNAME=                        # REQUIRED — the RDS master username you configured
DB_PASSWORD=                        # REQUIRED — the RDS master password you configured

# ── Local Development Database (docker-compose.local.yml) ─────
# Variables for local PostgreSQL container (matching docker-compose.local.yml)
POSTGRES_DB=ingoboka
POSTGRES_USER=ingoboka
POSTGRES_PASSWORD=                  # REQUIRED for local compose — e.g. local_dev_password_123

# ===== Platform admin (seeded once on first deploy if email is new) =====
# Changing these later does NOT update an existing admin — reset password in DB or via forgot-password.
PLATFORM_ADMIN_EMAIL=platform-admin@example.com
PLATFORM_ADMIN_PASSWORD=change-me-strong-admin-password
PLATFORM_ADMIN_PHONE=+250794415318

# ── S3 Document Storage ───────────────────────────────────────
# The EC2 instance IAM role provides credentials — no access keys needed here.
# S3_REGION must match the region where your S3 bucket was created.
S3_REGION=                          # REQUIRED — e.g. us-east-1
S3_BUCKET=                          # REQUIRED — e.g. ingoboka-documents-prod
# Optional: CloudFront distribution URL for presigned download URLs.
# Leave blank to use the default S3 endpoint.
S3_PUBLIC_BASE_URL=

# ── Security ──────────────────────────────────────────────────
# Generate with: openssl rand -base64 48
JWT_SECRET=                         # REQUIRED — minimum 256-bit random string

# ── SMTP (Gmail App Password) ────────────────────────────────
# MAIL_PASSWORD must be a Gmail App Password (16 chars, no spaces).
# Create at: https://myaccount.google.com/apppasswords
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=                      # REQUIRED — your Gmail address
MAIL_PASSWORD=                      # REQUIRED — Gmail App Password
MAIL_SMTP_AUTH=true
MAIL_SMTP_STARTTLS=true
MAIL_HEALTH_ENABLED=false

# ── Platform Admin Seed ───────────────────────────────────────
# Set SEED_PLATFORM_ADMIN=true only on first deploy to create the admin account.
# Set back to false after the first successful deploy.
SEED_PLATFORM_ADMIN=false
PLATFORM_ADMIN_EMAIL=               # REQUIRED if SEED_PLATFORM_ADMIN=true
PLATFORM_ADMIN_PASSWORD=            # REQUIRED if SEED_PLATFORM_ADMIN=true
PLATFORM_ADMIN_PHONE=               # REQUIRED if SEED_PLATFORM_ADMIN=true

# ── Frontend / CORS ───────────────────────────────────────────
CORS_ALLOWED_ORIGINS=https://ingoboka-platform.vercel.app
FRONTEND_LOGIN_URL=https://ingoboka-platform.vercel.app/en/login
FRONTEND_VERIFY_EMAIL_URL=https://ingoboka-platform.vercel.app/en/verify-email
FRONTEND_ACTIVATE_ACCOUNT_URL=https://ingoboka-platform.vercel.app/en/activate
FRONTEND_BASE_URL=https://ingoboka-platform.vercel.app/en
BRAND_LOGO_URL=https://ingoboka-platform.vercel.app/images/brand/ingoboka-logo.svg

# ── OTP Delivery ─────────────────────────────────────────────
# email = OTP sent by email (default, no SMS cost)
# sms   = OTP sent by SMS (requires Africa's Talking config below)
# log   = OTP printed in container logs (dev/debug only)
OTP_STORAGE=redis
OTP_DELIVERY_CHANNEL=email

# ── SMS — Africa's Talking (optional) ────────────────────────
AFRICASTALKING_SMS_ENABLED=false
AFRICASTALKING_USERNAME=sandbox
AFRICASTALKING_API_KEY=
AFRICASTALKING_SMS_API_URL=https://api.sandbox.africastalking.com/version1/messaging
AFRICASTALKING_SMS_FROM=

# ── USSD (optional) ───────────────────────────────────────────
# After EC2 has a public IP, set the AT callback URL to:
#   http://<EC2-IP>/api/v1/ussd/callback
USSD_ENABLED=false
USSD_SERVICE_CODE=*477#
USSD_GATEWAY_API_KEY=
USSD_SESSION_TTL_SECONDS=120
USSD_SESSION_STORAGE=redis
