# Copy to deploy/.env (never commit the real .env)
# Location on server: /opt/ingoboka/deploy/.env

# ===== PostgreSQL (Docker Compose service name: postgres) =====
POSTGRES_DB=ingoboka
POSTGRES_USER=ingoboka
# Quote passwords that contain special characters (e.g. !)
POSTGRES_PASSWORD="change-me-strong-password"

# ===== API =====
JWT_SECRET=change-me-use-openssl-rand-base64-32
API_PORT=8085
SEED_PLATFORM_ADMIN=true
IMAGE_TAG=latest

# ===== Platform admin (seeded once on first deploy if email is new) =====
# Changing these later does NOT update an existing admin — reset password in DB or via forgot-password.
PLATFORM_ADMIN_EMAIL=platform-admin@example.com
PLATFORM_ADMIN_PASSWORD=change-me-strong-admin-password
PLATFORM_ADMIN_PHONE=+250794415318

# ===== Frontend (production) =====
CORS_ALLOWED_ORIGINS=https://ingoboka-platform.vercel.app
FRONTEND_LOGIN_URL=https://ingoboka-platform.vercel.app/en/login
FRONTEND_VERIFY_EMAIL_URL=https://ingoboka-platform.vercel.app/en/verify-email
FRONTEND_ACTIVATE_ACCOUNT_URL=https://ingoboka-platform.vercel.app/en/activate
FRONTEND_BASE_URL=https://ingoboka-platform.vercel.app/en
BRAND_LOGO_URL=https://ingoboka-platform.vercel.app/images/brand/ingoboka-logo.svg

# ===== Demo data seed (docker profile) =====
SEED_DEMO_DATA=true

# ===== Gmail / SMTP (required for OTP and account emails) =====
# MUST be a Gmail App Password (16 chars) — NOT your normal Gmail password.
# Create at: https://myaccount.google.com/apppasswords (requires 2-Step Verification).
# Paste with or without spaces — the API strips spaces automatically.
# If you see "535-5.7.8 BadCredentials", regenerate the app password and update below.
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=your-gmail-app-password
MAIL_SMTP_AUTH=true
MAIL_SMTP_STARTTLS=true
# Set true only after SMTP works (optional deep health check)
MAIL_HEALTH_ENABLED=false

# ===== Redis (OTP) — hostname is the Docker service name =====
# REDIS_HOST and REDIS_PORT are injected by docker-compose

# ===== OTP delivery (no paid SMS required for demo) =====
# email = send 6-digit code by email (default, recommended)
# sms   = needs a real SMS provider below
# log   = dev only — OTP appears in `docker compose logs api`
OTP_DELIVERY_CHANNEL=email
MTN_BULK_SMS_ENABLED=false

# ===== Real SMS to the phone (USSD registration confirmation, OTP if channel=sms) =====
# Default: messages are LOGGED only (see `SMS [+250...]:` in api logs).
# Option A — Africa's Talking (recommended if you already use AT for USSD):
#   1. AFRICASTALKING_SMS_ENABLED=true
#   2. AFRICASTALKING_USERNAME=sandbox (or your live app username)
#   3. AFRICASTALKING_API_KEY=<same AT apiKey from dashboard — rotate if exposed>
#   4. Sandbox: add the handset number under AT → SMS → Sandbox → Phone Numbers
#   5. Keep MTN_BULK_SMS_ENABLED=false (do not enable both)
# Option B — MTN Rwanda bulk SMS:
#   MTN_BULK_SMS_ENABLED=true + MTN_BULK_SMS_API_KEY=...
AFRICASTALKING_SMS_ENABLED=false
AFRICASTALKING_USERNAME=sandbox
AFRICASTALKING_API_KEY=
AFRICASTALKING_SMS_API_URL=https://api.sandbox.africastalking.com/version1/messaging
AFRICASTALKING_SMS_FROM=

# ===== USSD (Africa's Talking sandbox) — DEMO/SANDBOX =====
# Callback URL to configure in AT: https://YOUR_HOST:8085/api/v1/ussd/callback
# Service code for demo: *477# (AT channel may show *384*…#)
USSD_ENABLED=true
USSD_SERVICE_CODE=*477#
USSD_GATEWAY_API_KEY=
USSD_SESSION_TTL_SECONDS=120
USSD_SESSION_STORAGE=redis

# ===== MinIO (document + profile image storage) =====
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=change-me-minio-secret
MINIO_BUCKET=ingoboka-documents
# Internal Docker hostname — API uploads use this (set automatically in docker-compose)
# MINIO_ENDPOINT=http://minio:9000
# Optional browser-reachable host for presigned product download URLs only.
# Profile photos and claim evidence (upload + view) use the API proxy — they do NOT need this.
# MINIO_PUBLIC_ENDPOINT=http://YOUR_IP:9000
# Example Azure demo VM (product PDFs/images only):
# MINIO_PUBLIC_ENDPOINT=http://4.168.192.169:9000
# MINIO_API_PORT=9000
# MINIO_CONSOLE_PORT=9001
# Set false only when object storage is intentionally disabled
# MINIO_ENABLED=true

# NOTE: Do NOT use localhost in DB_URL when running in Docker.
# The API container connects to hostname "postgres", not your machine.
# DB_URL is set automatically by docker-compose — you do not need it here.

# ===== Azure (or any new host) =====
# Full guide: docs/azure-deploy.md
# After the VM has a public IP, share with frontend:
#   API base:  http://YOUR_IP:8085/api/v1
#   Swagger:   http://YOUR_IP:8085/swagger-ui.html
# Update GitHub Actions secrets SERVER_HOST / SERVER_USERNAME / SERVER_SSH_KEY
# Update Africa's Talking USSD callback to the new host.
