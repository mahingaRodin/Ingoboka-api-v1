# Copy to load-tests/.env (never commit the real .env)
# Used by run-smoke.ps1, run-load.ps1, run-stress.ps1 and direct k6 runs.

# API base URL including /api/v1
BASE_URL=http://localhost:8085/api/v1

# Login credentials — partner demo user from your staging DB (or local PLATFORM_ADMIN_*).
# Local Docker: match PLATFORM_ADMIN_* from deploy/.env (see deploy/.env.example).
# CI: set GitHub secrets LOAD_TEST_EMAIL / LOAD_TEST_PASSWORD instead.
EMAIL=
PASSWORD=
